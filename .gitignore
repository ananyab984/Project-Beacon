# Dependencies
node_modules
.pnpm-store

# Environment variables & secrets
.env
.env.*
!.env.example
# .env.docker holds real secrets and stays ignored by the .env.* rule above;
# its template must be committed, and needs its own negation because
# !.env.example matches that exact name only.
!.env.docker.example
*.env

# Build outputs
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Cloudflare / Wrangler
.wrangler/
.dev.vars

# System & OS
.DS_Store
Thumbs.db

# IDEs & Editors
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
*.coverage
test-results/

# Scratch files
scratch_*
*.scratch.*

# Research PoCs -- local only, never committed
POC/
POC's/
