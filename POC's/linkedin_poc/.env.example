# Bright Data credentials & configuration.
# Copy this file to ".env" and fill in your real API key.
#   cp .env.example .env
#
# NEVER commit the real .env file (it is git-ignored).

# Your Bright Data API key (Account settings -> API keys).
BRIGHTDATA_API_KEY=

# The LinkedIn people-profile dataset id (from the spec / Bright Data docs).
DATASET_ID=gd_l1viktl72bvl7bjuj0

# ---- Optional overrides (sensible defaults are used if left blank) ----

# Per-request HTTP timeout in seconds. Sync profile enrichment takes 10-30s
# per Bright Data's docs, so keep this comfortably above that.
REQUEST_TIMEOUT=60

# Max retry attempts for transient failures (HTTP 429 / 5xx / timeout).
MAX_RETRIES=3

# Base delay (seconds) for exponential backoff between retries.
RETRY_BACKOFF_BASE=2

# Default input / output Excel paths (can be overridden on the CLI).
INPUT_PATH=LinkedIn_Enrichment_Test_Cases.xlsx
OUTPUT_PATH=enriched_output.xlsx

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
