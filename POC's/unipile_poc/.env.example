# Unipile API configuration
# Note: UNIPILE_DSN can be specified as host:port (e.g. api25.unipile.com:15598) or full URL (e.g. https://api25.unipile.com:15598/api/v1)
UNIPILE_DSN=api25.unipile.com:15598
UNIPILE_API_KEY=your_unipile_api_key_here
UNIPILE_WEBHOOK_SECRET=secret_g3_webhook_key_2026

# App configuration (APP_BASE_URL must be an accessible public URL like ngrok for live webhooks)
APP_BASE_URL=http://localhost:3000
PORT=3000
