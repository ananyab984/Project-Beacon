# Groq credentials & configuration for the AI draft-messages POC.
# Copy this file to ".env" and fill in your real API key.
#   cp .env.example .env
#
# NEVER commit the real .env file (it is git-ignored).

# Your Groq API key (https://console.groq.com/keys).
GROQ_API_KEY=

# Generation model. llama-3.3-70b-versatile = best draft quality.
# Swap to llama-3.1-8b-instant for faster / cheaper runs.
GROQ_MODEL=llama-3.3-70b-versatile

# Judge model used by the LLM-as-a-judge evaluator. Keep it a strong model
# so scores are trustworthy; can match GROQ_MODEL.
JUDGE_MODEL=llama-3.3-70b-versatile

# ---- Optional overrides (sensible defaults used if left blank) ----

# Sampling temperature for draft generation (0.0-1.0). Lower = more on-template.
GEN_TEMPERATURE=0.5

# Per-request HTTP timeout in seconds.
REQUEST_TIMEOUT=60

# Max retry attempts for transient failures (HTTP 429 / 5xx / timeout).
MAX_RETRIES=4

# Base delay (seconds) for exponential backoff between retries.
RETRY_BACKOFF_BASE=2

# Input dataset (enriched leads) and output directory.
INPUT_PATH=../Ada_poc/ada_projectbeacon_output.json
OUTPUT_DIR=output

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
