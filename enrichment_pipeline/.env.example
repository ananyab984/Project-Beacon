# API Keys for Production Enrichment Pipeline
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
DATASET_ID=gd_l1viktl72bvl7bjuj0

TAVILY_API_KEY=tvly-your_tavily_api_key_here

CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=haiku

# Configuration Overrides
REQUEST_TIMEOUT=60
MAX_RETRIES=3
LOG_LEVEL=INFO
PORT=8000

# Duplicate / identity-resolution stage ("Danny M rule") -- entirely LLM-based (Groq),
# separate from the CLAUDE_API_KEY used everywhere else in this pipeline. The model is
# shown the lead being tested plus every other already-enriched lead in the batch and
# returns its own same-person confidence score; pairs scoring >= the threshold below are
# flagged for human review, never auto-merged.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
DEDUP_MATCH_THRESHOLD=0.8

# Keepalive ping back to Render so the service stays warm.
KEEPALIVE_ENABLED=true
KEEPALIVE_URL=https://your-enrichment-service.onrender.com
KEEPALIVE_INTERVAL_SECONDS=600
