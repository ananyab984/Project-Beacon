# API Keys for Production Enrichment Pipeline
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
DATASET_ID=gd_l1viktl72bvl7bjuj0

TAVILY_API_KEY=tvly-your_tavily_api_key_here

CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=haiku

# Configuration Overrides
# REQUEST_TIMEOUT is a per-HTTP-request socket timeout; MAX_RETRIES=4 (5
# total attempts, 1s/2s/4s/8s backoff) plus a 15s wall-clock deadline per
# call are enforced in core/resilience.py regardless of this value.
REQUEST_TIMEOUT=10
MAX_RETRIES=4
LOG_LEVEL=INFO
PORT=8000

# Groq: the duplicate/identity-resolution stage ("Danny M rule") and the
# local-text mapping stages (Services classification, remaining-fields
# fill-only extraction) -- CLAUDE_API_KEY stays reserved for live web search
# and English normalization, which need Claude's tool support. For dedup,
# the model is shown the lead being tested plus every other already-enriched
# lead in the batch and returns its own same-person confidence score; pairs
# scoring >= the threshold below are flagged for human review, never
# auto-merged.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
DEDUP_MATCH_THRESHOLD=0.8

# Keepalive ping back to Render so the service stays warm.
KEEPALIVE_ENABLED=true
KEEPALIVE_URL=https://your-enrichment-service.onrender.com
KEEPALIVE_INTERVAL_SECONDS=600

# Parallel (Tier 2 enrichment for every platform -- replaces Clay in this
# exact waterfall position; Clay's stage was LinkedIn-only, Parallel is not).
# Optional: unset means Stage 3.5 is a no-op. The SDK
# call itself no longer takes a guessed per-call timeout (two successive
# guesses, 150s then 240s, both cut off calls that were genuinely still
# succeeding server-side -- confirmed live 2026-09-07) -- it now defers to
# the parallel-web SDK's own well-engineered default (genuinely waits up to
# an hour for the task to finish). PARALLEL_DEADLINE_SECONDS below is this
# pipeline's OUTER retry-sequence deadline and must stay comfortably above
# that ~3600s SDK ceiling (see config.py's parallel_deadline_seconds comment).
# PARALLEL_API_KEY=your_parallel_api_key_here
# PARALLEL_PROCESSOR=core
# PARALLEL_DEADLINE_SECONDS=3700
