# API Keys for Production Enrichment Pipeline
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
DATASET_ID=gd_l1viktl72bvl7bjuj0

TAVILY_API_KEY=tvly-your_tavily_api_key_here

CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001
GROQ_API_KEY=your_groq_api_key_here

# Configuration Overrides
REQUEST_TIMEOUT=60
MAX_RETRIES=3
LOG_LEVEL=INFO
PORT=8000

PARALLEL_API_KEY=your_parallel_api_key_here
# Processor tier, all platforms (one of: lite base core pro ultra)
PARALLEL_PROCESSOR=core
PARALLEL_DEADLINE_SECONDS=3700
# Leads enriched at once -- SAME value as the server's ENRICHMENT_CONCURRENCY
# (sizes the per-lead thread pools; see core/resilience.py).
ENRICHMENT_CONCURRENCY=16
# How long uvicorn lets running leads finish on SIGTERM (below the platform's
# kill window).
PY_GRACEFUL_SHUTDOWN_SECONDS=25
