# npm still treats NODE_ENV=production as an implicit signal to skip
# devDependencies on a plain `npm install` (confirmed directly: reproduced
# locally, went from 374 packages to 104 the moment NODE_ENV=production was
# set, silently dropping typescript's own @types packages along with it).
# Render's build needs typescript, @types/*, and prisma to actually build
# the app -- those are real build-time requirements, not "only for local
# dev" -- so devDependencies must always install here regardless of
# NODE_ENV. This is what actually broke the first production deploy after
# NODE_ENV=production was set (missing @types/express, @types/node caused
# `npm run build` to fail with TS7016/TS2304/TS2591).
production=false
