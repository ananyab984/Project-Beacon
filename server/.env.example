# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# DATABASE_URL_BD=
DATABASE_URL=postgresql://user:password@host/database
# DATABASE_URL_PROD=

NEON_AUTH_URL=https://your-neon-auth-url.com

UNIPILE_DSN=api25.unipile.com:15598
UNIPILE_API_KEY=your_unipile_api_key
UNIPILE_WEBHOOK_SECRET=your_unipile_webhook_secret
APP_BASE_URL=http://localhost:5001

DRAFTING_SERVICE_URL=http://127.0.0.1:8001
ENRICHMENT_SERVICE_URL=http://127.0.0.1:8000
# Leads enriched at once -- SAME value as enrichment_pipeline's
# ENRICHMENT_CONCURRENCY (see docs/DOCKER_DEPLOY.md "Enrichment throughput").
# src/prisma.ts gives Prisma a 20-connection pool unless DATABASE_URL sets one.
ENRICHMENT_CONCURRENCY=8
# SIGTERM: let in-flight enrichments finish this long, then requeue the rest.
# Must stay below the platform's kill window (30s default).
SHUTDOWN_DRAIN_MS=20000
# After boot, requeue leads an earlier (crashed) process left IN_PROGRESS.
# 300000 on Render (overlapping deploys), 0 on AWS (stop-before-start).
REQUEUE_DELAY_MS=300000
# Rows per bulk upload / Sheet import (their JSON body limit fits 2000).
BULK_UPLOAD_MAX_ROWS=2000

UNIPILE_WEBHOOK_PATH_TOKEN=your_unipile_webhook_path_token

ONBOARDING_WEBHOOK_PATH_TOKEN=your_onboarding_webhook_path_token
ONBOARDING_WEBHOOK_SECRET=your_onboarding_webhook_secret

# --- Drafting (in-process, server/src/drafting/) ---
CLAUDE_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-haiku-4-5
GEN_TEMPERATURE=0.5
REQUEST_TIMEOUT=60
MAX_RETRIES=4
RETRY_BACKOFF_BASE=2.0

AUTUMN_API_KEY=your_autumn_api_key

# Slack bot token (recruiter DM notifications)
SLACK_BOT_TOKEN=xoxb-your-bot-token
