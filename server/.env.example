# Database (NeonDB PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database"

# JWT Secrets (can use defaults for development)
JWT_SECRET=super_secret_jwt_access_key_global3_2026
REFRESH_TOKEN_SECRET=super_secret_jwt_refresh_key_global3_2026

# Neon Auth
NEON_AUTH_URL=https://your-neon-auth-url.com

# Unipile Integration
UNIPILE_DSN=api25.unipile.com:15598
UNIPILE_API_KEY=your_unipile_key
UNIPILE_WEBHOOK_SECRET=your_webhook_secret
UNIPILE_WEBHOOK_PATH_TOKEN=your_path_token

# Clay Integration
CLAY_WEBHOOK_SECRET=your_clay_webhook_secret
CLAY_WEBHOOK_PATH_TOKEN=your_clay_path_token

# Services
ENRICHMENT_SERVICE_URL=http://127.0.0.1:8000
APP_BASE_URL=http://localhost:5001
CLIENT_URL=http://localhost:5173

# Claude (in-process drafting and FAQ auto-tagging)
CLAUDE_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=sonnet
GEN_TEMPERATURE=0.5
REQUEST_TIMEOUT=60
MAX_RETRIES=4
RETRY_BACKOFF_BASE=2.0

# Optional
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_MS=600000
