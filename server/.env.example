# Database (NeonDB PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database"

# Neon Auth
NEON_AUTH_URL=https://your-neon-auth-url.com

# Unipile Integration
UNIPILE_DSN=api25.unipile.com:15598
UNIPILE_API_KEY=your_unipile_key
UNIPILE_WEBHOOK_SECRET=your_webhook_secret
UNIPILE_WEBHOOK_PATH_TOKEN=your_path_token

# Slack (recruiter DM notifications) -- a secret, set directly here/in the
# deployment environment, never owner-editable in-app. Get it from
# api.slack.com/apps -> your app -> OAuth & Permissions -> Bot User OAuth Token.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Services
ENRICHMENT_SERVICE_URL=http://127.0.0.1:8000
# Must be set to the SAME value as enrichment_pipeline/.env's own
# ENRICHMENT_SERVICE_SHARED_SECRET -- proves a call to that service actually
# came from this server, not an arbitrary caller who found the URL. A
# mismatch (or missing value on either side) means every enrichment call
# fails with 401.
ENRICHMENT_SERVICE_SHARED_SECRET=your_shared_secret_here
APP_BASE_URL=http://localhost:5001
CLIENT_URL=http://localhost:5173

# Claude (in-process drafting and FAQ auto-tagging)
CLAUDE_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=sonnet
GEN_TEMPERATURE=0.5
REQUEST_TIMEOUT=60
MAX_RETRIES=4
RETRY_BACKOFF_BASE=2.0

# Groq (inbound reply classification)
GROQ_API_KEY=your_groq_api_key
# Must match the in-code default in src/config.ts. llama-3.3-70b-versatile is
# deprecated on Groq and 404s -- classification then fails silently (caught,
# logged as CLASSIFICATION_FAILED, message still marked processed).
GROQ_MODEL=openai/gpt-oss-20b
# Single kill switch for the whole feature -- set to "false" to disable the
# webhook classifier, block manual overrides, and hide it in the client.
REPLY_CLASSIFICATION_ENABLED=true

# Optional
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_MS=600000
