{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  // Tests are standalone assert scripts run directly via ts-node (see any
  // *.test.ts header), never imported by src -- keep them out of dist/ so the
  // deployed artifact carries no test code.
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"]
}
