# Configuration for AI Message Drafting Layer
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001
# GEN_TEMPERATURE=0.5
GROQ_API_KEY=

REQUEST_TIMEOUT=60
MAX_RETRIES=4
LOG_LEVEL=INFO
PORT=8001

# Keepalive ping back to Render so the service stays warm.
KEEPALIVE_ENABLED=true
KEEPALIVE_URL=https://your-drafting-service.onrender.com
KEEPALIVE_INTERVAL_SECONDS=600
