# Template for .env.docker (gitignored). Copy, then fill in:
#   cp .env.docker.example .env.docker
#
# Covers BOTH processes in the container -- the Node API and the Python
# enrichment service read from this one environment, which is the main
# benefit of merging them: ENRICHMENT_SERVICE_SHARED_SECRET is now one value
# that cannot drift between two services.
#
# Do NOT point this at server/.env. That file carries a real SLACK_BOT_TOKEN,
# real APP_BASE_URL/CLIENT_URL, and an ENRICHMENT_SERVICE_URL that would
# override the image default and send Node to the OLD public Python service.
#
# Sources: render.yaml plus both .env.example files. Three keys present in
# server/.env are intentionally absent here -- ONBOARDING_WEBHOOK_PATH_TOKEN,
# ONBOARDING_WEBHOOK_SECRET and DRAFTING_SERVICE_URL are read nowhere in
# src/ any more (drafting is in-process; its only mentions are comments).


# =============================================================================
# REQUIRED -- the container crash-loops without every one of these
# =============================================================================
# The first five throw inside src/config.ts at import time, before Express
# ever listens. The next four throw the same way, but only when
# NODE_ENV=production (which the image sets). DATABASE_URL is the odd one
# out: config.ts never checks it, so it fails later and differently -- at
# `prisma migrate deploy` during startup.
#
# A missing value here is never a degraded start. It is a crash loop.

# Postgres (Neon). Used by `prisma migrate deploy` at boot and every query.
# Migrations are applied on EVERY container start, so point this at the
# branch you actually mean.
DATABASE_URL=

# Neon Auth issuer; this server only verifies the JWTs it issues.
# Same value as the client's VITE_NEON_AUTH_URL.
NEON_AUTH_URL=

# Unipile (LinkedIn/email integration).
UNIPILE_API_KEY=
UNIPILE_DSN=
UNIPILE_WEBHOOK_SECRET=
UNIPILE_WEBHOOK_PATH_TOKEN=

# This container's own public origin. Used to build the Unipile webhook
# notify_url for every NEW account connection. Accounts connected before a
# move keep posting to the OLD value -- see the go-live section of
# docs/DOCKER_DEPLOY.md before changing hosts.
APP_BASE_URL=

# The deployed frontend's real origin. CORS rejects every browser request
# otherwise. The frontend's VITE_API_BASE_URL must point back at this
# container.
CLIENT_URL=

# Shared secret for the Node -> Python /enrich call, sent as the
# X-Enrichment-Shared-Secret header. Read by BOTH processes from this one
# variable. Python fails closed: unset means every /enrich returns 401 while
# /health still reports healthy, so a broken deploy looks green.
# Generate with:  openssl rand -hex 32
ENRICHMENT_SERVICE_SHARED_SECRET=


# =============================================================================
# SET BY THE IMAGE -- leave these alone
# =============================================================================
# The Dockerfile already sets all of these, and platform environment
# OVERRIDES the image's ENV. Setting them here (or in a Render dashboard /
# ECS task definition) is how you silently send Node to the wrong place.
#
#   NODE_ENV=production
#   PORT=5001                                 (hosts may inject their own)
#   ENRICHMENT_PORT=8001                      (Python's private port)
#   ENRICHMENT_SERVICE_URL=http://127.0.0.1:8001
#   KEEPALIVE_ENABLED=false                   (host is always-on)
#   TZ=UTC
#
# If you ever do need to override ENRICHMENT_SERVICE_URL: NO TRAILING SLASH.
# enrichment.job.ts builds `${url}/enrich` by plain concatenation, so a
# trailing slash yields a double slash and a 404.


# =============================================================================
# OPTIONAL -- enrichment providers
# =============================================================================
# All optional to BOOT. Python calls load_config(require_keys=False), so with
# these unset it starts fine, /health still says "healthy", and enrichment
# silently does a fraction of the work. /health's providers_configured map is
# what actually tells you which tiers are wired up -- check it after deploy.
#
# Leave these unset for a smoke-test container: no keys, no spend.
BRIGHTDATA_API_KEY=
DATASET_ID=
TAVILY_API_KEY=
PARALLEL_API_KEY=
PARALLEL_PROCESSOR=core
PARALLEL_DEADLINE_SECONDS=3700.0
CLAUDE_API_KEY=
CLAUDE_MODEL=
GROQ_API_KEY=
GROQ_MODEL=


# =============================================================================
# OPTIONAL -- behaviour and tuning (image/code defaults shown)
# =============================================================================
# Kill switch for the 9 in-process cron jobs. Defaults true; every real
# deployment wants them. Set false ONLY for a throwaway container that must
# boot without side effects -- with jobs on, booting sends Slack posts,
# due-date reminders and weekly digests, and spends money on enrichment
# every 3 minutes.
# EXACTLY ONE instance may run these: pollInFlight is in-memory, so a second
# instance doubles every digest and blows past the ENRICHMENT_CONCURRENCY cap.
BACKGROUND_JOBS_ENABLED=true

# Enrichment throughput -- one container, so one value sizes both Node's poller
# and Python's pools. Raise stepwise (docs/DOCKER_DEPLOY.md "Enrichment
# throughput"); src/prisma.ts sizes the DB pool unless DATABASE_URL sets one.
ENRICHMENT_CONCURRENCY=16
# Shutdown/restart handling. With ECS stopTimeout=120: SHUTDOWN_GRACE_SECONDS=110,
# SHUTDOWN_DRAIN_MS=90000, PY_GRACEFUL_SHUTDOWN_SECONDS=100. Defaults fit a 30s window.
SHUTDOWN_GRACE_SECONDS=30
SHUTDOWN_DRAIN_MS=20000
PY_GRACEFUL_SHUTDOWN_SECONDS=25
# Stop-before-start deploys and one container: nothing older can still be running.
REQUEUE_DELAY_MS=0
BULK_UPLOAD_MAX_ROWS=2000

# Allows REAL outbound Unipile sends (a genuine email or LinkedIn message to a
# real third party). Defaults to BLOCKED everywhere except production, after a
# live test send once reached a real person's inbox. NODE_ENV=production is set
# by the image, so in a container this defaults to ALLOWED -- set it to false
# explicitly for any test or staging container.
UNIPILE_ALLOW_LIVE_SENDS=

# Slack alerts. LEAVE UNSET for any test container -- real messages go out.
SLACK_BOT_TOKEN=

# Inbound reply classification (Groq). Defaults on.
REPLY_CLASSIFICATION_ENABLED=true

# LLM generation tuning (Node side).
GEN_TEMPERATURE=
REQUEST_TIMEOUT=
MAX_RETRIES=
RETRY_BACKOFF_BASE=

# Keepalive is a free-tier anti-sleep hack and the image pins
# KEEPALIVE_ENABLED=false, since a paid always-on host never sleeps. These two
# only matter if you deliberately turn it back on (e.g. pointing at an external
# uptime pinger). KEEPALIVE_URL falls back to APP_BASE_URL when blank.
KEEPALIVE_URL=
KEEPALIVE_INTERVAL_MS=600000
KEEPALIVE_INTERVAL_SECONDS=600

# Re-enrichment limits (Autumn).
AUTUMN_API_KEY=
AUTUMN_BASE_URL=
AUTUMN_REENRICH_COOLDOWN_MINUTES=
AUTUMN_REENRICH_DAILY_CAP=
AUTUMN_REENRICH_TIMEOUT_SECONDS=

# Due-date reminder lookahead.
DUE_DATE_REMINDER_WINDOW_DAYS=

# Python-side timeouts, deadlines and logging.
BRIGHTDATA_REQUEST_TIMEOUT=30
BRIGHTDATA_DEADLINE_SECONDS=60.0
FAST_PROVIDER_REQUEST_TIMEOUT=15
FAST_PROVIDER_DEADLINE_SECONDS=45.0
CLAUDE_WEBSEARCH_DEADLINE_SECONDS=300.0
STAGE6_WEBSEARCH_ENABLED=false
DEDUP_MATCH_THRESHOLD=0.8
LOG_LEVEL=INFO

# Supervisor tuning (docker/start.sh). Python is restarted in place when it
# dies; exceeding this budget takes the whole container down instead of
# flapping forever behind a healthy-looking API.
PY_MAX_RESTARTS=5
PY_RESTART_WINDOW_SECONDS=60
